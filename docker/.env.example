# Copy to docker/.env and fill in values for password-reset email (optional).
# See docs/email_setup.md for Gmail app-password instructions.

FSX_SMTP_HOST=smtp.gmail.com
FSX_SMTP_PORT=587
FSX_SMTP_USER=your-email@gmail.com
FSX_SMTP_PASSWORD=your-app-password
FSX_SMTP_FROM=your-email@gmail.com
FSX_RESET_BASE_URL=http://localhost:8000
